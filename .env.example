# copy to .env and fill in. never commit .env.

# FortyGuard tOS Enterprise API key. backend refuses to start without it.
FORTYGUARD_API_KEY=

# production: https://api.fortyguard.com
# development: https://tos-enterprise-api.dev.app.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# where cached API responses land. quota is small, cache is load-bearing.
CACHE_DIR=backend/data/cache

# where `pytest validation/ -m validation` writes its report. /api/validation reads it
# and never computes. A relative path is anchored to the repo root, not to the cwd.
VALIDATION_PATH=docs/VALIDATION.json

# origins the browser is allowed to call the API from. comma separated. A deployment
# MUST add its own frontend origin here or every request fails CORS in the browser.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# backend origin the frontend talks to
NEXT_PUBLIC_API_URL=http://localhost:8000
