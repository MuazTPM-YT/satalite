# The backend origin. Next inlines NEXT_PUBLIC_* at BUILD time, so this must be set
# before `next build` — changing it afterwards changes nothing.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where this deployment is served from. Only the metadata reads it: canonical URL,
# Open Graph, robots.txt and sitemap.xml are all absolute, and a crawler cannot
# resolve a relative one. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Basemap override (optional) ───────────────────────────────────────────────
# The map view ships with keyless Esri basemaps and needs none of this. Set these
# only to point the map at your own tile provider — including one with an API key
# baked into the template — without editing code.
#
# NEXT_PUBLIC_* is inlined at BUILD time, so these are read by `next build`, not at
# runtime. All four are ignored unless NEXT_PUBLIC_MAP_TILE_URL is set, and a bad
# value is refused with a reason on the console rather than half-applied: the map
# falls back to the built-in Esri basemaps.
#
# A url TEMPLATE, not a base url. {z}, {x} and {y} in whatever order your provider
# uses — Esri, for one, orders its path {z}/{y}/{x}.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#
# REQUIRED whenever the url is set. Attribution is a licence condition of every tile
# provider worth using, so a source without it is refused rather than served.
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
#
# The deepest zoom your provider really holds tiles for. Past it the tiles below are
# scaled up rather than requested, so the map goes soft instead of blank. Defaults to
# 19, which is as deep as the view can go.
# NEXT_PUBLIC_MAP_MAX_ZOOM=19
#
# What the basemap switcher calls it. Defaults to "Custom".
# NEXT_PUBLIC_MAP_LABEL=OpenStreetMap
